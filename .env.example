# Wisdom Engine settings — copy to .env (git-ignored) and edit.
# Precedence: OS environment variables always override these values.
#
# SECRETS: keep OPENROUTER_API_KEY in your OS environment, e.g. in
# ~/.profile:  export OPENROUTER_API_KEY="sk-or-..."
# (You *can* put it here as a fallback, but the OS env is preferred.)

# OpenRouter backend (used when OPENROUTER_API_KEY is set in the OS env)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama backend (local fallback)
OLLAMA_HOST=http://localhost:11434
# Defaults to the first installed model when unset:
#OLLAMA_MODEL=qwen3:8b

# Transport: stdio (default, client spawns the server) or streamable-http
# (one long-running shared server at http://HOST:PORT/mcp).
#WISDOM_TRANSPORT=streamable-http
#WISDOM_HTTP_HOST=127.0.0.1
#WISDOM_HTTP_PORT=8765
