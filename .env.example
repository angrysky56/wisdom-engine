# Copy to .env (git-ignored). OS environment variables take precedence.
# Keep credentials in the process environment when practical:
# OPENROUTER_API_KEY or (native route only) TYPESAFE_API_KEY.

# Stable local storage. Use an absolute path if overriding:
#WISDOM_DATA_DIR=/absolute/path/to/wisdom-data

WISDOM_JEV_PROVIDER=openrouter
WISDOM_JEV_MODEL=~typesafe/jev-latest
# Native alternative:
#WISDOM_JEV_PROVIDER=typesafe
#WISDOM_JEV_MODEL=jev-latest

# Defaults to stdio. Optional local HTTP endpoint: http://127.0.0.1:8765/mcp
#WISDOM_TRANSPORT=streamable-http
#WISDOM_HTTP_HOST=127.0.0.1
#WISDOM_HTTP_PORT=8765
